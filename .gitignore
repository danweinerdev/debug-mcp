# Rust build output (CARGO_TARGET_DIR may relocate this elsewhere)
/target

# Host-side dev-container cache populated by claude-container.sh (CARGO_HOME +
# CARGO_TARGET_DIR bind-mounted into the container at /cache/*).
/.cache

# Editor / IDE state.
/.vscode

# Compiled C test fixtures (built locally / in CI from the .c sources)
testdata/*.exe
testdata/**/*.exe
testdata/**/*.pdb
testdata/**/*.ilk
testdata/**/*.obj
# Unix fixtures have no extension; ignore the known built binaries by name.
testdata/simple
testdata/loop
testdata/crash
testdata/structs
testdata/multithread
